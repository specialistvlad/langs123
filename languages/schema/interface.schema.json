{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interface wording",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "varieties"
  ],
  "properties": {
    "text": {
      "description": "Wording by key, one string per explanation language.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/localized"
      }
    },
    "varieties": {
      "description": "The name of each variety of a language being learned (the variety enum of curriculum.schema.json and topic.schema.json) in every explanation language: the renderer writes it beside text that serves one variety alone.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en-GB",
        "en-US",
        "es-419",
        "es-ES",
        "fr-FR",
        "fr-CA"
      ],
      "properties": {
        "en-GB": {
          "$ref": "#/definitions/localized"
        },
        "en-US": {
          "$ref": "#/definitions/localized"
        },
        "es-419": {
          "$ref": "#/definitions/localized"
        },
        "es-ES": {
          "$ref": "#/definitions/localized"
        },
        "fr-FR": {
          "$ref": "#/definitions/localized"
        },
        "fr-CA": {
          "$ref": "#/definitions/localized"
        }
      }
    },
    "slots": {
      "description": "The name of each slot code of CONVENTIONS.md §12 in every explanation language; a code without a name renders as written.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/localized"
      }
    },
    "counts": {
      "description": "Counts by key: in every explanation language, one form per plural category its plural rules use (Intl.PluralRules), other always; {n} is the number.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/counted"
      }
    }
  },
