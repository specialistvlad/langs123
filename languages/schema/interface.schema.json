{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interface wording",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "description": "Wording by key, one string per explanation language.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/localized"
      }
    },
    "slots": {
      "description": "The name of each slot code of CONVENTIONS.md §12 in every explanation language; a code without a name renders as written.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/localized"
      }
    }
  },
  "definitions": {
    "localized": {
      "description": "Text in every explanation language.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "uk",
        "es",
        "pt",
        "fr",
        "de",
        "it",
        "pl",
        "tr",
        "id",
        "vi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "uk": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        },
        "pt": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        },
        "it": {
          "type": "string",
          "minLength": 1
        },
        "pl": {
          "type": "string",
          "minLength": 1
        },
        "tr": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vi": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
