{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "curriculum.schema.json",
  "title": "langs123 curriculum",
  "description": "Every planned topic of every language being learned: sections by category, and the study path by level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "languages"
  ],
  "properties": {
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "enabled",
          "slug",
          "flag",
          "name",
          "sections",
          "path"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "description": "ISO 639-1 code of the language being learned; its topics live in languages/{code}/"
          },
          "enabled": {
            "type": "boolean",
            "description": "false keeps the language from readers; its data stays and is still checked"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z]+$",
            "description": "URL segment of the language being learned"
          },
          "flag": {
            "type": "string",
            "minLength": 1,
            "description": "The page icon of the language being learned: a flag emoji that marks its pages and links"
          },
          "name": {
            "$ref": "#/definitions/localized"
          },
          "explain": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/explain"
            },
            "description": "The explanation languages the language is written for, the source language of site.yaml first; every explanation language when absent."
          },
          "varieties": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/variety"
            },
            "description": "The varieties a reader chooses between, the default first. An element tagged with a variety shows only while that variety is chosen."
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dir",
                "title",
                "topics"
              ],
              "properties": {
                "dir": {
                  "type": "string",
                  "pattern": "^\\d\\d-[a-z0-9-]+$"
                },
                "title": {
                  "$ref": "#/definitions/trackLocalized"
                },
                "topics": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "slug"
                    ],
                    "properties": {
                      "slug": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                      },
                      "levels": {
                        "type": "string",
                        "pattern": "^(A0|A1|A2|B1|B2|C1|C2)(-(A0|A1|A2|B1|B2|C1|C2))?$",
                        "description": "Planned range of a topic without a topic file; a written topic takes its range from its data."
                      },
                      "title": {
                        "$ref": "#/definitions/trackLocalized"
                      }
                    }
                  }
                }
              }
            },
            "description": "Topics by category; the menu's Categories order."
          },
          "path": {
            "type": "object",
            "description": "The study path: per level, lowest first, the topics to study at that level, in order. A topic comes back at each level where it grows.",
            "propertyNames": {
              "$ref": "#/definitions/level"
            },
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9-]+\\.[a-z0-9-]+$",
                "description": "Topic ID: {lang}.{section}.{topic}"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "level": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "explain": {
      "enum": [
        "en",
        "uk",
        "es",
        "pt",
        "fr",
        "de",
        "it",
        "pl",
        "tr",
        "id",
        "vi"
      ]
    },
    "variety": {
      "description": "A variety of a language being learned, as a BCP 47 tag.",
      "enum": [
        "en-GB",
        "en-US",
        "es-419",
        "es-ES"
      ]
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "uk",
        "es",
        "pt",
        "fr",
        "de",
        "it",
        "pl",
        "tr",
        "id",
        "vi"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "uk": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "pt": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "de": {
          "type": "string"
        },
        "it": {
          "type": "string"
        },
        "pl": {
          "type": "string"
        },
        "tr": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "vi": {
          "type": "string"
        }
      }
    },
    "trackLocalized": {
      "description": "Text in each explanation language of the language being learned; npm run check requires exactly those.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "en": {
          "type": "string"
        },
        "uk": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "pt": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "de": {
          "type": "string"
        },
        "it": {
          "type": "string"
        },
        "pl": {
          "type": "string"
        },
        "tr": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "vi": {
          "type": "string"
        }
      }
    }
  }
}
