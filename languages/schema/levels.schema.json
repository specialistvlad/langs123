{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Level scale",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "levels"
  ],
  "properties": {
    "levels": {
      "description": "Levels, lowest first.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "description",
          "hue"
        ],
        "properties": {
          "code": {
            "$ref": "#/definitions/level"
          },
          "name": {
            "$ref": "#/definitions/localized"
          },
          "description": {
            "$ref": "#/definitions/localized"
          },
          "hue": {
            "description": "The level's hue on the OKLCH colour wheel, in degrees; the theme sets lightness and chroma.",
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          }
        }
      }
    }
  },
  "definitions": {
    "localized": {
      "description": "Text in every explanation language.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "uk",
        "es",
        "pt",
        "fr",
        "de",
        "it",
        "pl",
        "tr",
        "id",
        "vi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "uk": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        },
        "pt": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        },
        "it": {
          "type": "string",
          "minLength": 1
        },
        "pl": {
          "type": "string",
          "minLength": 1
        },
        "tr": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vi": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "level": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    }
  }
}
